[Unit]
Description=Puluo browser outbound network guard
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/nft -f /etc/puluo/browser-egress.nft
ExecReload=/usr/sbin/nft -f /etc/puluo/browser-egress.nft
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
