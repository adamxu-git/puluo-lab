add table inet puluo_browser
flush table inet puluo_browser

table inet puluo_browser {
    set blocked_ipv4 {
        type ipv4_addr
        flags interval
        elements = { @BLOCKED@ }
    }
    set model_ipv4 {
        type ipv4_addr
        elements = { @MODEL@ }
    }
    chain output {
        type filter hook output priority filter; policy accept;
        ct state established,related accept
        meta skuid "proxy" jump proxy_output
        oifname "lo" accept
        meta skuid 0 accept
        meta skuid "systemd-network" ip protocol udp udp sport 68 udp dport 67 accept
        ip daddr @model_ipv4 tcp dport 443 accept
        reject
    }
    chain proxy_output {
        # Squid uses loopback UDP to communicate with its own helpers.
        oifname "lo" udp dport != 53 accept
        fib daddr type local reject
        ip daddr @blocked_ipv4 reject
        ip daddr { 1.1.1.1, 223.5.5.5 } udp dport 53 accept
        ip daddr { 1.1.1.1, 223.5.5.5 } tcp dport 53 accept
        meta nfproto ipv4 tcp dport { 80, 443 } accept
        reject
    }
}
