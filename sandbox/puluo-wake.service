[Unit]
Description=Run one experiment turn in the existing DSH session
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/puluo/deepseek-key
ConditionPathExists=/etc/puluo/wake.txt
ConditionPathExists=/etc/puluo/system-prompt.yml

[Service]
Type=oneshot
ExecStart=/opt/puluo/guest-run.py experiment
TimeoutStartSec=10min
UMask=0077
