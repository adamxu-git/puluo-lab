# Sourced by host commands. The original acceptance VM predates named instances.
name=${PULUO_VM_NAME:-puluo-ubuntu}
if [[ ! "$name" =~ ^[a-z][a-z0-9-]{0,39}$ || "$name" == puluo-golden ]]; then
  printf 'Invalid experiment VM name.\n' >&2
  exit 2
fi
if [[ "$name" == puluo-ubuntu ]]; then
  state="$root/state"
  logs="$root/logs"
else
  state="$root/instances/$name/state"
  logs="$root/instances/$name/logs"
fi
