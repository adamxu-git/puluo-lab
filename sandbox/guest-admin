#!/bin/bash
set -euo pipefail

root=$(cd -- "$(dirname -- "$0")" && pwd)
source "$root/instance-env"
address=$("$root/vm" ip)
if [[ ! "$address" =~ ^10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ &&
      ! "$address" =~ ^192\.168\.[0-9]{1,3}\.[0-9]{1,3}$ &&
      ! "$address" =~ ^172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
  printf 'Tart returned an unexpected management address.\n' >&2
  exit 1
fi
exec /usr/bin/ssh -F /dev/null -i "$state/setup-key" \
  -o IdentitiesOnly=yes -o IdentityAgent=none -o BatchMode=yes -o ConnectTimeout=5 \
  -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$state/known-hosts" \
  "setup@$address" "$@"
